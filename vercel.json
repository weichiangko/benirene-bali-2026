{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/tools/:name",
      "destination": "/api/tools?name=:name"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/openapi"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/config.js",
      "destination": "/api/site?f=config"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "/api/site?f=manifest"
    },
    {
      "source": "/ai",
      "destination": "/api/site?f=llms"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/site?f=llms"
    },
    {
      "source": "/install.sh",
      "destination": "/api/site?f=install"
    },
    {
      "source": "/duplicate",
      "destination": "/api/site?f=duplicate"
    },
    {
      "source": "/icon.svg",
      "destination": "/api/icon?f=svg"
    },
    {
      "source": "/icon-192.png",
      "destination": "/api/icon?size=192"
    },
    {
      "source": "/icon-512.png",
      "destination": "/api/icon?size=512"
    },
    {
      "source": "/apple-touch-icon.png",
      "destination": "/api/icon?size=180"
    }
  ],
  "functions": {
    "api/site.js": {
      "includeFiles": "docs/**"
    }
  }
}
